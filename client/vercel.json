{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://imovie-2ax2.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://imovie-2ax2.onrender.com/api/auth/:path*"
    },
    {
      "source": "/((?!api/|auth/).*)",
      "destination": "/index.html"
    }
  ]
}
