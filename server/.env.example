# ===============================================
# iMovies - Server Environment Configuration
# ===============================================

# Server & Runtime Environment
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Database Connection (Local or MongoDB Atlas)
# For Render / Cloud: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imovies?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/imovies

# Real-Time Market Movies (TMDB API)
TMDB_API_KEY=f9e6f30f4548a45cc24820d273e12ec9

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_TpQ7mg5jyDRTt0
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here

# IMPORTANT: Sender email MUST be validated on Brevo dashboard (Senders & IP)
SENDER_EMAIL=sandeepnayak998182@gmail.com
SENDER_NAME=iMovies

# Frontend Client URL (Used for direct email verification links)
# For Render / Cloud: https://your-frontend.vercel.app or https://your-app.onrender.com
CLIENT_URL=http://localhost:5173

# Optional: Direct Gmail SMTP Configuration (Alternative to Brevo)
